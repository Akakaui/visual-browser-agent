{
  "name": "visual-browser-agent",
  "version": "0.1.0",
  "description": "Local-first, Playwright-enhanced visual browser package for AI coding agents. Connects agents to real Chrome/Chromium with structured inspection, visual evidence, human handoff, and portable Agent Skills.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "visual-browser-agent": "./bin/visual-browser-agent.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build && npm test",
    "init": "node ./bin/visual-browser-agent.js init",
    "doctor": "node ./bin/visual-browser-agent.js doctor",
    "mcp": "node ./bin/visual-browser-agent.js mcp"
  },
  "keywords": [
    "mcp",
    "playwright",
    "browser",
    "automation",
    "ai-agent",
    "visual-testing",
    "agent-skills"
  ],
  "author": "Akakaui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akakaui/visual-browser-agent.git"
  },
  "homepage": "https://github.com/Akakaui/visual-browser-agent#readme",
  "bugs": {
    "url": "https://github.com/Akakaui/visual-browser-agent/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "ora": "^8.0.0",
    "playwright": "^1.45.0",
    "semver": "^7.6.0",
    "which": "^4.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/chalk": "^0.4.31",
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/ora": "^3.1.0",
    "@types/semver": "^7.5.0",
    "@types/which": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "wrappers",
    "browser-extension",
    "EXTENSION_INSTALLATION.md"
  ]
}
